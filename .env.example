# AskMyDocs (RAG) Environment Configuration

# Chroma Vector Database Directory
CHROMA_DB_DIR=./data/chroma_db

# MongoDB Atlas Persistent Memory Store Connection String
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority

# Groq API Key for Llama 3.1 8B Instant LLM Generation
# Sign up and get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
